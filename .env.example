# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Only needed when the API key is not scoped to a workspace (Console -> Settings -> Workspaces, id "wrkspc_...")
ANTHROPIC_WORKSPACE_ID=
TYPESAFE_API_KEY=

# Optional overrides
TECTO_LLM_MODEL=claude-sonnet-5-5
TECTO_JEV_MODEL=jev-latest
# live | replay  (replay = use recorded Jev answers from tests/fixtures/jev, no network)
TECTO_JEV_MODE=live
TECTO_DATA_DIR=var
